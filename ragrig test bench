        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_micros();
    let temp = std::env::temp_dir().join(format!("ragrig_bench_{}_{}", format, ts));
    std::fs::create_dir_all(&temp)?;

    let mut count = 0;
    for entry in dir.files() {
        let name = entry
            .path()
            .file_name()
            .and_then(|n| n.to_str())
            .unwrap_or("unknown");
        std::fs::write(temp.join(name), entry.contents())?;
        count += 1;
