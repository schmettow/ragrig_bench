        .ok_or_else(|| anyhow!("Fixture path must start with '{}'", FIXTURE_PREFIX))?;

    let dir: &Dir = match format {
        "pdf" => &ragrig::fixtures::pdf::DIR,
        "html" => &ragrig::fixtures::html::DIR,
        "rmd" => &ragrig::fixtures::rmd::DIR,
        other => anyhow::bail!(
