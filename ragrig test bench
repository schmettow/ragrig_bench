#[tokio::main]
async fn main() -> Result<()> {
    let cwd = std::env::current_dir()?;

    let args = Args {
        folder: cwd,
        provider: Provider::Ollama,
        model: CHAT_MODEL.into(),
        deepseek_api_key: None,
        deepseek_model: String::new(),
        semantic_scholar_api_key: None,
