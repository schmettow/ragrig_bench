        threads: 4,
        embedding_concurrency: 32,
        chunk_size: 1024,
        chunk_overlap: 128,
        top_k: 10,
        similarity_threshold: 0.4,
        model_ctx_tokens: 4096,
    };

    let embedder = EmbedderSpec::from_args(&args).build()?;
    let chat_agent = ChatAgentSpec::Ollama {
        model: CHAT_MODEL.into(),
