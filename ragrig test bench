   125	/// `"… \"n_ctx\":4096 …"` or `"… n_ctx: 4096 …"`.
   126	fn extract_ollama_n_ctx(msg: &str) -> Option<usize> {
   127	    // JSON-style: "n_ctx":4096 or "n_ctx":"4096"
   128	    for needle in &["\"n_ctx\":", "n_ctx:"] {
   129	        if let Some(pos) = msg.find(needle) {
   130	            let rest = msg[pos + needle.len()..].trim_start();
   131	            let num: String = rest
   132	                .chars()
   133	                .take_while(|c| c.is_ascii_digit())
   134	                .collect();
   135	            if let Ok(n) = num.parse::<usize>() {
   136	                return Some(n);
   137	            }
   138	        }
   139	    }
   140	    None
   141	}
